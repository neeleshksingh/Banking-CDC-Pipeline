# Debezium connector registration. Host/port are as seen from the Connect container.
# Copy to .env and fill in.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password>
POSTGRES_DB=banking

# Optional
# CONNECT_URL=http://localhost:8083
# CONNECTOR_NAME=banking-cdc-connector
