# Kafka -> MinIO consumer, when run on the host. Copy to .env and fill in.
# (The docker-compose `consumer` service overrides the endpoints with in-network ones.)

# Kafka
KAFKA_BOOTSTRAP=localhost:29092
KAFKA_GROUP=minio-landing-group

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=<minio_root_user>
MINIO_SECRET_KEY=<minio_root_password>
MINIO_BUCKET=raw

# Optional
# BATCH_SIZE=500
# FLUSH_SECONDS=10
